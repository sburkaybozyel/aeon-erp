{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "db/**",
          "aeon/**",
          "modules/**",
          "crm/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/crm/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/crm/(.*)",
      "dest": "crm/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}

