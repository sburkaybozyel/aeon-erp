{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/**",
          "db/**",
          "modules/**",
          "routes/**",
          "lib/**",
          "seed/**",
          "catalog-seed.js",
          "ingredient-seed.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
