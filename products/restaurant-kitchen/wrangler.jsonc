{
  "name": "aeon-restaurant-kitchen",
  "main": "cloudflare-worker.js",
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aeon-restaurant-kitchen-module-db",
      "database_id": "3440092d-c116-454e-a427-6961da304563"
    }
  ],
  "services": [
    {
      "binding": "RECEPTION_SERVICE",
      "service": "aeon-reception"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "vars": {
    "MODULE_ID": "restaurant-kitchen",
    "MODULE_NAME": "AEON Restaurant & Kitchen",
    "MODULE_DEFAULT_TENANT": "restaurant_kitchen",
    "MODULE_ALLOWED_TENANTS": "restaurant_kitchen",
    "MODULE_D1_BOOTSTRAP": "true",
    "MODULE_BUILD_ID": "restaurant-kitchen-copy-2026-08-17-menu-relay",
    "RECEPTION_MODULE_URL": "https://aeon-reception.aeon-global.workers.dev",
    "INITIAL_RESTAURANT_PIN": "2222",
    "INITIAL_KITCHEN_PIN": "3333"
  }
}
