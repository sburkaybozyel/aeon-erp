{
  "name": "aeon-reception",
  "main": "cloudflare-worker.js",
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aeon-reception-module-db",
      "database_id": "45186a6f-70b8-4160-a4ba-ad10e8bb8cd9"
    }
  ],
  "services": [
    { "binding": "CRM_SERVICE", "service": "aeon-crm" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "vars": {
    "MODULE_ID": "reception",
    "MODULE_NAME": "AEON Reception",
    "MODULE_DEFAULT_TENANT": "reception",
    "MODULE_ALLOWED_TENANTS": "reception",
    "MODULE_D1_BOOTSTRAP": "true",
    "MODULE_BUILD_ID": "reception-copy-2026-08-17-integrated-hub",
    "CRM_MODULE_URL": "https://aeon-crm.aeon-global.workers.dev",
    "RESTAURANT_MODULE_URL": "https://aeon-restaurant-kitchen.aeon-global.workers.dev",
    "INITIAL_RECEPTION_PIN": "1234"
  }
}
